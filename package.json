{
  "name": "desksweep",
  "version": "0.2.1",
  "description": "An open-source robot vacuum that tidies your desktop. Safe by design: nothing is ever deleted, every sweep can be undone.",
  "license": "MIT",
  "author": "DeskSweep contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaylakCreative/DeskSweep-.git"
  },
  "homepage": "https://github.com/SaylakCreative/DeskSweep-#readme",
  "bugs": {
    "url": "https://github.com/SaylakCreative/DeskSweep-/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "dev:dry": "npm run build && electron . --dry-run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "capture": "npm run build && electron scripts/capture/capture.cjs",
    "pack": "npm run build && electron-builder --win --dir --publish never",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "keywords": [
    "desktop",
    "cleanup",
    "electron",
    "robot-vacuum",
    "organizer"
  ],
  "build": {
    "appId": "com.desksweep.app",
    "productName": "DeskSweep",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SaylakCreative",
        "repo": "DeskSweep-"
      }
    ],
    "files": [
      "dist/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "dist/native/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false
    },
    "artifactName": "DeskSweep-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "license": "LICENSE"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "gifenc": "^1.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
