<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for DeskSweep.
  GitHub wraps the uploaded installer in a ZIP, so the root element is <zip-file>.
  Paste this into SignPath (Project > Artifact configurations > Add); its editor validates the schema.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="DeskSweep-Setup-*.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
